// NOTIFICATIONS

model Notification {
  id        String     @id @default(cuid())
  userId    String
  orderId   String?    // opsional — notif bisa tidak terkait order
  type      NotifType
  title     String
  body      String
  isRead    Boolean    @default(false)
  actionUrl String?    // URL yang dibuka ketika notif diklik
  createdAt DateTime   @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order?     @relation(fields: [orderId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

// CHAT
// Satu order = satu chat room
model ChatRoom {
  id        String           @id @default(cuid())
  orderId   String           @unique
  isOpen    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  order     Order            @relation(fields: [orderId], references: [id])
  members   ChatRoomMember[]
  messages  ChatMessage[]

  @@map("chat_rooms")
}

model ChatRoomMember {
  id         String    @id @default(cuid())
  roomId     String
  userId     String
  lastReadAt DateTime?

  room       ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@map("chat_room_members")
}

model ChatMessage {
  id         String        @id @default(cuid())
  roomId     String
  senderId   String
  senderType MessageSender
  body       String        @db.Text
  imageUrl   String?       // lampiran gambar
  isDeleted  Boolean       @default(false)
  createdAt  DateTime      @default(now())

  room       ChatRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender     User          @relation(fields: [senderId], references: [id])

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

// STATIC CONTENT (FAQ, About, dll — dikelola admin)

model Content {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "faq", "about", "terms", "privacy", "refund"
  title     String
  body      String   @db.Text // rich text / markdown
  updatedBy String?  // userId admin yang terakhir edit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contents")
}
