// JOKIWIR — Prisma Schema
// Database: PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ENUMS

enum Role {
  USER
  ADMIN
  JOKI
}

enum OrderStatus {
  PENDING       // baru dibuat, belum bayar
  AWAITING      // sudah bayar, belum di-assign joki
  ASSIGNED      // joki sudah di-assign oleh admin
  IN_PROGRESS   // joki sedang mengerjakan
  COMPLETED     // joki selesai, menunggu konfirmasi user
  DONE          // user konfirmasi, order selesai
  CANCELLED     // dibatalkan sebelum dikerjakan
  REFUNDED      // sudah direfund
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum PaymentProvider {
  MIDTRANS
  MANUAL // transfer manual, konfirmasi admin
}

enum ServiceCategory {
  BOSS_FIGHT
  ITEM_HUNTING
  GRINDING
  NPC_QUEST
}

enum BadgeType {
  SAVE      // hemat
  POPULAR   // populer
  RARE      // langka/sulit
  SECRET    // boss tersembunyi
}

enum NotifType {
  ORDER_CREATED
  ORDER_ASSIGNED
  ORDER_PROGRESS
  ORDER_COMPLETED
  ORDER_CANCELLED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  BROADCAST
  PROMO
}

enum MessageSender {
  USER
  ADMIN
  JOKI
  SYSTEM
}

enum VoucherType {
  PERCENTAGE  // diskon persen, e.g. 10%
  FIXED       // diskon nominal, e.g. Rp 20.000
}

// AUTH & USER

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String
  phone         String?
  avatarUrl     String?
  passwordHash  String?   // null jika login via OAuth
  role          Role      @default(USER)
  isActive      Boolean   @default(true)
  isBanned      Boolean   @default(false)
  bannedReason  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // NextAuth relations
  accounts      Account[]
  sessions      Session[]

  // App relations
  orders        Order[]         @relation("UserOrders")
  assignedOrders Order[]        @relation("JokiOrders")
  progressLogs  OrderProgress[] @relation("JokiProgress")
  reviews       Review[]
  // wishlistItems Wishlist[]
  notifications Notification[]
  chatMessages  ChatMessage[]
  chatRooms     ChatRoomMember[]

  @@map("users")
}

// NextAuth — OAuth accounts (Google, dll)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// NextAuth — sessions
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// NextAuth — email verification & password reset tokens
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// GAME & SERVICE CATALOG

model Game {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  description  String    @db.Text
  note         String?   // catatan singkat di atas tabel harga
  pillBg       String    // warna background pill, e.g. "#EEEDFE"
  pillColor    String    // warna teks pill, e.g. "#3C3489"
  coverUrl     String?   // gambar cover game
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  services     Service[]
  orderItems   OrderItem[]

  @@map("games")
}

model Service {
  id               String          @id @default(cuid())
  gameId           String
  category         ServiceCategory
  name             String
  detail           String?         // deskripsi kecil di bawah nama
  priceUnit        Int?            // harga satuan dalam rupiah
  priceUnitLabel   String?         // e.g. "/ set", "/ boss"
  priceBundle      Int?            // harga bundle
  priceBundleLabel String?         // e.g. "Hemat 47%", "all DLC boss"
  estimateMin      Int             // estimasi minimum dalam menit
  estimateMax      Int             // estimasi maksimum dalam menit
  badge            BadgeType?
  isActive         Boolean         @default(true)
  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  game             Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  orderItems       OrderItem[]
  // wishlistItems    Wishlist[]
  reviews          Review[]

  // Index untuk query katalog per game
  @@index([gameId, category, isActive])
  @@map("services")
}

// ORDERS

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique // e.g. "JKW-20240511-001"
  userId         String
  jokiId         String?     // null sampai admin assign
  status         OrderStatus @default(PENDING)

  // Harga
  subtotal       Int         // total sebelum diskon
  discountAmount Int         @default(0)
  finalAmount    Int         // yang harus dibayar

  // Voucher yang dipakai (jika ada)
  voucherCode    String?
  voucherId      String?

  // Info game account (untuk BMW yang butuh akses akun)
  gameAccount    String?     @db.Text // dienkripsi di application layer
  notes          String?     @db.Text // catatan dari user

  // Timestamps
  paidAt         DateTime?
  assignedAt     DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  doneAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  user           User        @relation("UserOrders", fields: [userId], references: [id])
  joki           User?       @relation("JokiOrders", fields: [jokiId], references: [id])
  voucher        Voucher?    @relation(fields: [voucherId], references: [id])
  items          OrderItem[]
  payment        Payment?
  progress       OrderProgress[]
  review         Review?
  notifications  Notification[]
  chatRoom       ChatRoom?

  // Index untuk query order per user & status
  @@index([userId, status])
  @@index([jokiId, status])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  serviceId       String
  gameId          String
  // Snapshot harga saat order — tidak berubah meski harga naik
  serviceName     String
  gameName        String
  category        String
  priceSnapshot   Int
  quantity        Int      @default(1)

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service         Service  @relation(fields: [serviceId], references: [id])
  game            Game     @relation(fields: [gameId], references: [id])

  @@map("order_items")
}

// Log progress pengerjaan oleh joki
model OrderProgress {
  id           String   @id @default(cuid())
  orderId      String
  jokiId       String
  step         String   // e.g. "Boss Margit selesai"
  note         String?  @db.Text
  proofUrl     String?  // URL screenshot/video bukti
  createdAt    DateTime @default(now())

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  joki         User     @relation("JokiProgress", fields: [jokiId], references: [id])

  @@index([orderId])
  @@map("order_progress")
}

// PAYMENTS

model Payment {
  id               String          @id @default(cuid())
  orderId          String          @unique
  provider         PaymentProvider @default(MIDTRANS)
  externalId       String?         // transaction_id dari Midtrans
  idempotencyKey   String          @unique // cegah double charge
  status           PaymentStatus   @default(PENDING)
  amount           Int
  snapToken        String?         // Midtrans Snap token
  snapRedirectUrl  String?
  rawResponse      Json?           // simpan raw response dari gateway
  paidAt           DateTime?
  expiredAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  order            Order           @relation(fields: [orderId], references: [id])

  @@index([status])
  @@index([externalId])
  @@map("payments")
}

// VOUCHERS

model Voucher {
  id            String      @id @default(cuid())
  code          String      @unique
  description   String?
  type          VoucherType
  value         Int         // persen (10 = 10%) atau nominal (20000 = Rp20.000)
  minOrder      Int         @default(0)   // minimum total order
  maxDiscount   Int?        // maksimum diskon (untuk tipe persen)
  usageLimit    Int?        // null = unlimited
  usageCount    Int         @default(0)
  perUserLimit  Int         @default(1)   // berapa kali per user
  isActive      Boolean     @default(true)
  startAt       DateTime?
  expiredAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  orders        Order[]
  usages        VoucherUsage[]

  @@map("vouchers")
}

// Tracking siapa pakai voucher apa — untuk enforce perUserLimit
model VoucherUsage {
  id        String   @id @default(cuid())
  voucherId String
  userId    String
  orderId   String   @unique
  usedAt    DateTime @default(now())

  voucher   Voucher  @relation(fields: [voucherId], references: [id])

  @@unique([voucherId, userId, orderId])
  @@map("voucher_usages")
}

// REVIEWS

model Review {
  id        String   @id @default(cuid())
  orderId   String   @unique // satu order = satu review
  userId    String
  serviceId String
  rating    Int      // 1–5
  comment   String?  @db.Text
  isVisible Boolean  @default(true) // admin bisa sembunyikan
  repliedAt DateTime?
  reply     String?  @db.Text // balasan admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order     Order    @relation(fields: [orderId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  service   Service  @relation(fields: [serviceId], references: [id])

  @@index([serviceId, isVisible])
  @@map("reviews")
}

